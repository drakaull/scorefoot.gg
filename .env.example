# Copy to .env and fill in. Never commit .env.

# API-Football key (dashboard.api-football.com > Account > My Access)
API_FOOTBALL_KEY=

# PostgreSQL (local only)
POSTGRES_DB=scorefoot
POSTGRES_USER=scorefoot
POSTGRES_PASSWORD=

# Production server only: read docker-compose.prod.yml on top of docker-compose.yml (no published ports,
# web on the external network `edge`, capped logs). Leave commented on a development machine.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
